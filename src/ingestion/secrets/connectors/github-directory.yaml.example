apiVersion: v1
kind: Secret
metadata:
  name: insight-github-directory-main
  labels:
    app.kubernetes.io/part-of: insight
  annotations:
    insight.cyberfabric.com/connector: github-directory
    insight.cyberfabric.com/source-id: github-directory-main
type: Opaque
stringData:
  # Needs `read:org` to list organization members. Add `user:email` if member
  # emails should be collected — without it `email` is null for every member
  # and identity resolution leans on the login binding alone.
  github_token: "ghp_CHANGE_ME"
  # JSON array — reconcile parses the decoded value, so a bare comma-separated
  # string would arrive as one organization name.
  github_organizations: '["myorg"]'
